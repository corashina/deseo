# Set at least 32 random characters. Only the cleanup scheduler uses this secret.
MEMORY_CLEANUP_SECRET=
# Set at least 32 random characters for the notification scheduler.
NOTIFICATION_WORKER_SECRET=
# Use an authorized token when enhanced Expo push security is enabled.
EXPO_ACCESS_TOKEN=

# Set exact browser origins, separated by commas. Restart Edge functions after changes.
WEB_APP_ORIGIN=https://app.example.test
# Set the browser-accessible Supabase API base.
PUBLIC_SUPABASE_URL=https://project.supabase.co
